{
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/producto/:id*",
      "destination": "/index.html"
    },
    {
      "source": "/tienda",
      "destination": "/index.html"
    },
    {
      "source": "/nosotros",
      "destination": "/index.html"
    },
    {
      "source": "/contacto",
      "destination": "/index.html"
    },
    {
      "source": "/envios",
      "destination": "/index.html"
    },
    {
      "source": "/cambios",
      "destination": "/index.html"
    },
    {
      "source": "/faq",
      "destination": "/index.html"
    },
    {
      "source": "/terminos",
      "destination": "/index.html"
    },
    {
      "source": "/privacidad",
      "destination": "/index.html"
    },
    {
      "source": "/cookies",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/checkout",
      "destination": "/index.html"
    },
    {
      "source": "/cuenta",
      "destination": "/index.html"
    },
    {
      "source": "/favoritos",
      "destination": "/index.html"
    },
    {
      "source": "/seguimiento",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
